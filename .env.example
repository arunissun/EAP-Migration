# Copy this file to .env. Never commit the copy.
# GO_EAP_API_TOKEN is the value after "Token" in the staging API credential.
GO_EAP_API_TOKEN=

# Used to expand ${GO_EAP_CONTACT_EMAIL} placeholders in case files.
GO_EAP_CONTACT_EMAIL=uat@example.org

# Optional client tuning. The staging origin remains fixed by the application.
GO_EAP_TIMEOUT_SECONDS=30
GO_EAP_GET_RETRIES=3
# Optional lower local limit; it cannot exceed the API's 100 MB limit.
GO_EAP_MAX_FILE_SIZE_BYTES=104857600
